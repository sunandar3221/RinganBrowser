#include <windows.h>

1 24 "assets/app.manifest"
101 ICON "assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ringan Browser Project"
            VALUE "FileDescription",  "RinganBrowser - Ultra-Lightweight Modern Web Browser"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "RinganBrowser"
            VALUE "LegalCopyright",   "Open Source MIT License"
            VALUE "OriginalFilename", "RinganBrowser.exe"
            VALUE "ProductName",      "RinganBrowser"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
